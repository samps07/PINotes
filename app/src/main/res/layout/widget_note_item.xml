<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_item"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_item_pin"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/btn_star_big_on"
            android:visibility="gone"
            android:contentDescription="Pinned" />

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Note Title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Category"
            android:textSize="10sp"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Note content preview..."
        android:textSize="11sp"
        android:textColor="#475569"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
